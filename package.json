{
  "name": "playwright-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright regression suite for an e-commerce site: backend API checks, browser flows and an end-to-end customer journey",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test tests/api",
    "test:ui": "playwright test tests/ui tests/journey",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "imapflow": "^1.0.164"
  },
  "license": "MIT"
}

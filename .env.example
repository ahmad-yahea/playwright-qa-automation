# Copy to .env and fill in. .env is git-ignored; never commit real values.
# In CI the same names come from repository secrets (MAIL_*, TEST_*) and variables (everything else).

# --- Target environment (required) ---------------------------------------
BASE_URL=https://shop.example.com
API_URL=https://api.shop.example.com/api/v1

# --- Mailbox the suite reads verification emails from (any IMAP provider) ---
# With these set, every run signs up a fresh customer. Leave empty to skip signup steps.
MAIL_HOST=
MAIL_PORT=993
MAIL_USER=
MAIL_PASSWORD=
# Address the +alias is added to (defaults to MAIL_USER), e.g. qa@example.com
MAIL_ADDRESS_BASE=
# Subject of the verification email the app sends
VERIFY_EMAIL_SUBJECT=Verify your email

# --- Optional: a pre-verified customer (used when no mailbox is set) -------
TEST_EMAIL=
TEST_PASSWORD=

# --- Delivery-zone fixtures of the environment under test -------------------
# A zone id plus one point inside and one outside it (see your zones endpoint).
ZONE_IN_ID=
ZONE_IN_NAME=Zone A
ZONE_IN_LAT=53.3881
ZONE_IN_LNG=-6.377
ZONE_OUT_LAT=30.008
ZONE_OUT_LNG=31.211

# --- Sample address used by address tests (postal code must be valid for your market) ---
SAMPLE_ADDRESS_LINE=1 Main St
SAMPLE_CITY=Dublin
SAMPLE_COUNTRY=Ireland
SAMPLE_POSTAL_CODE=D15 X2R4
